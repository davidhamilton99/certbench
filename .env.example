# Read by src/env.ts. The two public Supabase values are required for the app
# to start. A server secret is checked where it is used: a missing one is
# named in a warning as the server starts and in /api/health, and the feature
# that needs it fails or is skipped.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LINK_SIGNING_SECRET (optional) signs shared readiness links and story links. Until it is set, SUPABASE_SERVICE_ROLE_KEY signs them; setting it voids every link made before.

# Stripe (use TEST keys on local/preview; LIVE only in production env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# App URL (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Without the key every email is skipped, not sent.
RESEND_API_KEY=
# EMAIL_FROM="CertBench <hello@certbench.dev>"
# The sender's postal address, which the owner supplies. Once it is set, every
# email prints it in its footer after "Sent by CertBench." (anti-spam law in
# Canada and the United States expects a commercial email to carry one).
# EMAIL_POSTAL_ADDRESS="Street, City, Province and postal code, Country"

# The daily lifecycle-email cron (vercel.json). Vercel sends it as the cron's
# Bearer token, so it must be set for Production too: without it every run
# fails before it starts, and no lifecycle email goes out.
CRON_SECRET=

# Sentry (optional; if unset, all Sentry code paths no-op)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=

# Type generation (scripts/check-db-types.mjs)
# SUPABASE_PROJECT_ID=mdvkidwkjjfgfwkogqvq
# SUPABASE_ACCESS_TOKEN=
