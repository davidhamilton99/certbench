# Validated by src/env.ts — missing required vars fail loudly at boot.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Stripe (use TEST keys on local/preview; LIVE only in production env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# App URL (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Without the key every email is skipped, not sent.
RESEND_API_KEY=
# EMAIL_FROM="CertBench <hello@certbench.dev>"

# The daily lifecycle-email cron (vercel.json). Vercel sends it as the cron's
# Bearer token, so it must be set for Production too: without it every run
# fails before it starts, and no lifecycle email goes out.
CRON_SECRET=

# Sentry (optional; if unset, all Sentry code paths no-op)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=

# Type generation (scripts/check-db-types.mjs)
# SUPABASE_PROJECT_ID=mdvkidwkjjfgfwkogqvq
# SUPABASE_ACCESS_TOKEN=
